{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "baseUrl": ".",
    "paths": {
      "framer-motion": ["src/shims/framer-motion.tsx"],
      "next/image": ["src/shims/next-image.tsx"]
    }
  },
  "include": ["src", "remotion.config.ts", "scripts"]
}
